# Anenji HA Bridge — Environment Configuration
# Copy to .env and fill in your values

# MQTT broker (usually localhost if running on same host as HA, or no if docker in other place)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=USER
MQTT_PASSWORD=PASSWORD

# EnerWise cloud dongle port (default 1883)
DONGLE_PORT=1883

# MQTT topic prefix for Home Assistant
MQTT_TOPIC_PREFIX=solar/inverter

# Your inverter dongle credentials (from EnerWise/Anenji app)
DONGLE_DEVICE_ID=your_device_id_here
DONGLE_PRODUCT=your_product_code_here
